{
  "regions": ["sin1"],
  "functions": { "api/rpc.js": { "maxDuration": 30, "includeFiles": "lib/**" }, "api/setup.js": { "maxDuration": 60, "includeFiles": "{lib,seed}/**" } },
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "ungdungdoichieukv8.vercel.app" }], "destination": "/doichieu/", "permanent": false },
    { "source": "/((?!doichieu/).*)", "has": [{ "type": "host", "value": "ungdungdoichieukv8.vercel.app" }], "destination": "/doichieu/", "permanent": false },
    { "source": "/doichieu/:path*", "missing": [{ "type": "host", "value": "ungdungdoichieukv8.vercel.app" }], "destination": "https://ungdungdoichieukv8.vercel.app/", "permanent": false },
    { "source": "/", "has": [{ "type": "host", "value": "tonghopbaocaokv8.vercel.app" }], "missing": [{ "type": "query", "key": "cong" }], "destination": "/tonghop/", "permanent": false },
    { "source": "/tonghop", "destination": "/tonghop/", "permanent": false },
    { "source": "/cv1953", "destination": "/cv1953/", "permanent": false },
    { "source": "/doichieu", "destination": "https://ungdungdoichieukv8.vercel.app/", "permanent": false },
    { "source": "/tonghop.html", "destination": "/tonghop/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/", "has": [{ "type": "host", "value": "bcdautucong-kv8.vercel.app" }], "missing": [{ "type": "query", "key": "cong" }], "destination": "/cv1953/index.html" }
  ],
  "headers": [
    { "source": "/cv1953/(.*)", "headers": [ { "key": "Cache-Control", "value": "no-cache, must-revalidate" } ] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "same-origin" }
    ] }
  ]
}
